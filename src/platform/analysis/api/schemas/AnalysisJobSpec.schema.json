{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisJobSpec",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "analysis_job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "stream_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "template_version_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "deployment_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "deployment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "model_version_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        },
        "required": [
          "role",
          "deployment_id",
          "model_version_id"
        ]
      },
      "description": "Each role must be unique; references are not resolved by this validation API."
    },
    "target_fps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 240
    },
    "desired_state": {
      "type": "string",
      "enum": [
        "RUNNING",
        "STOPPED"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  },
  "required": [
    "schema_version",
    "analysis_job_id",
    "source_id",
    "stream_profile_id",
    "template_version_id",
    "deployment_refs",
    "target_fps",
    "desired_state",
    "generation"
  ]
}
