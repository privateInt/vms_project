{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vms:camera:planned:device-delete:v1",
  "title": "DeviceDelete (planned, not activated)",
  "$comment": "Request body at root; planned response in $defs/DeviceDeleteResponse. Static shape only: raw integer syntax, headers, active children, usage, replay, concurrency and atomic persistence require implementation tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected_version"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807,
      "description": "Exact signed 64-bit JSON integer token. Fractions and exponent notation must be rejected by the HTTP decoder."
    }
  },
  "$defs": {
    "DeviceID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      },
      "description": "Existing Device ID rules. Unlike Source ID, lowercase validate is a valid device ID."
    },
    "DeviceDeletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "device_id",
        "version",
        "deleted_at"
      ],
      "properties": {
        "schema_version": {
          "const": "v1"
        },
        "device_id": {
          "$ref": "#/$defs/DeviceID"
        },
        "version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9223372036854775807
        },
        "deleted_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "not": {
            "pattern": "\\s"
          }
        }
      }
    },
    "DeviceDeleteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deletion",
        "registration_state",
        "runtime_verified",
        "request_id"
      ],
      "properties": {
        "deletion": {
          "$ref": "#/$defs/DeviceDeletion"
        },
        "registration_state": {
          "const": "DELETED"
        },
        "runtime_verified": {
          "const": false
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
