{
  "openapi": "3.1.0",
  "info": {
    "title": "Camera credential version write integration API",
    "version": "0.1.0-credential-write-http",
    "description": "Implemented HTTP component for explicit integration only. Not registered by the current camera executable or its active OpenAPI. Direct TLS 1.2+, bearer authentication, trusted principal resolver, transactional authorizer and admitted credential store are required. Backup work is excluded by user decision 2026-10-08."
  },
  "x-runtime-activated": false,
  "x-body-limit-bytes": 65536,
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/credentials/{credential_id}/versions": {
      "post": {
        "operationId": "writeCredentialVersion",
        "description": "Strict exact-key UTF-8 JSON, no duplicate keys at any input level, no unpaired UTF-16 surrogates, one signed integer token per version/port, no query or conditional headers. Identity comes only from trusted context. Source/target permission and full-operation lease are retained in storage.",
        "parameters": [
          {
            "name": "credential_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialVersionWrite"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New immutable version or replay of its original metadata receipt; never returns target or secret.",
            "headers": {
              "Idempotency-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialWriteReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query, precondition, idempotency key or strict JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "TLS or secret-management permission required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Only POST is supported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "ID, exact version, device, access state or idempotency conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid credential input semantics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authorization, admission or store unavailable; private errors are suppressed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CredentialVersionWrite": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "device_id",
          "expected_version",
          "target",
          "secret"
        ],
        "properties": {
          "schema_version": {
            "const": "v1"
          },
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "x-integer-token-required": true,
            "description": "0 creates the credential; a positive exact head version appends an immutable version."
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol",
              "host",
              "port"
            ],
            "properties": {
              "protocol": {
                "const": "RTSP"
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "writeOnly": true,
                "description": "Canonical IP without brackets/zone, or dotted ASCII DNS name with alphabetic final label. No normalization or network call."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "x-integer-token-required": true
              }
            },
            "writeOnly": true
          },
          "secret": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "username",
              "password"
            ],
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                "writeOnly": true,
                "x-max-utf8-bytes": 128,
                "description": "Must contain non-whitespace text; exact spelling is preserved."
              },
              "password": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                "writeOnly": true,
                "x-max-utf8-bytes": 4096,
                "description": "Exact bytes, including surrounding spaces, are preserved."
              }
            },
            "writeOnly": true
          }
        }
      },
      "CredentialMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_id",
          "device_id",
          "credential_version",
          "created_at"
        ],
        "properties": {
          "credential_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "credential_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CredentialWriteReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential",
          "request_id"
        ],
        "properties": {
          "credential": {
            "$ref": "#/components/schemas/CredentialMetadata"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
