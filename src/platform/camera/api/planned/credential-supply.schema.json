{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vms:camera:planned:credential-supply-plan:v1",
  "title": "Camera credential production supply plan v1 (review only)",
  "$comment": "Static installation-plan declaration; not an approved binding, admission Record, deployment tool or activation receipt. Companion validator checks canonical paths/IPs, UID separation and lexical mount/backup boundaries. It does not read secrets/files, inspect mounts, authenticate TLS/roles, derive key/CA/endpoint hashes, discover backup topology or bootstrap authority. Strict raw parser rejects duplicate/escaped-alias keys and all decimal/exponent/non-finite number tokens; max32768 UTF8 bytes.",
  "x-vms-contract-status": "planned",
  "x-vms-contract-scope": "camera local installation-plan; not HTTP or runtime authorization",
  "$ref": "#/$defs/SupplyPlan",
  "$defs": {
    "Path": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$",
      "not": {
        "pattern": "[^A-Za-z0-9/._-]"
      },
      "description": "Canonical absolute Linux path; semantic validator rejects dot/parent segments. Declaration only, no filesystem proof."
    },
    "SHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[^0-9a-f]"
      }
    },
    "UID": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967294
    },
    "RuntimeID": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967294
    },
    "IP": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45
    },
    "FileMount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_path",
        "container_path",
        "read_only"
      ],
      "properties": {
        "host_path": {
          "$ref": "#/$defs/Path"
        },
        "container_path": {
          "$ref": "#/$defs/Path"
        },
        "read_only": {
          "const": true
        }
      }
    },
    "DirectoryMount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_path",
        "container_path",
        "read_only"
      ],
      "properties": {
        "host_path": {
          "$ref": "#/$defs/Path"
        },
        "container_path": {
          "$ref": "#/$defs/Path"
        },
        "read_only": {
          "const": true
        }
      }
    },
    "SupplyPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "profile_kind",
        "intent",
        "inventory_basis",
        "project_root",
        "database",
        "tls",
        "maintenance",
        "runtime",
        "key_supply",
        "authority",
        "declared_snapshot_roots"
      ],
      "properties": {
        "format_version": {
          "const": 1
        },
        "profile_kind": {
          "const": "camera-credential-supply-plan"
        },
        "intent": {
          "const": "review-only"
        },
        "inventory_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_sha256",
            "api_version",
            "schema_version"
          ],
          "properties": {
            "source_sha256": {
              "$ref": "#/$defs/SHA256"
            },
            "api_version": {
              "const": "0.7.0-device-delete"
            },
            "schema_version": {
              "const": 7
            }
          }
        },
        "project_root": {
          "$ref": "#/$defs/Path"
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "target_schema_version",
            "host_ip",
            "port",
            "host_data_directory",
            "container_data_directory",
            "hba_file",
            "server_certificate_file",
            "server_private_key_file",
            "server_uid"
          ],
          "properties": {
            "name": {
              "const": "vms_camera"
            },
            "target_schema_version": {
              "const": 9
            },
            "host_ip": {
              "$ref": "#/$defs/IP"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "host_data_directory": {
              "$ref": "#/$defs/Path"
            },
            "container_data_directory": {
              "const": "/var/lib/postgresql/data"
            },
            "hba_file": {
              "$ref": "#/$defs/FileMount"
            },
            "server_certificate_file": {
              "$ref": "#/$defs/FileMount"
            },
            "server_private_key_file": {
              "$ref": "#/$defs/FileMount"
            },
            "server_uid": {
              "$ref": "#/$defs/RuntimeID"
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "minimum_version",
            "server_name",
            "ca_file",
            "expected_ca_sha256",
            "ca_policy"
          ],
          "properties": {
            "mode": {
              "const": "verify-full"
            },
            "minimum_version": {
              "const": "TLS1.2"
            },
            "server_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "ca_file": {
              "$ref": "#/$defs/FileMount"
            },
            "expected_ca_sha256": {
              "$ref": "#/$defs/SHA256"
            },
            "ca_policy": {
              "const": "single-reviewed-ca-no-fallback-v1"
            }
          }
        },
        "maintenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uid",
            "source_ip",
            "database_role",
            "control_database",
            "control_dsn_file",
            "target_dsn_file",
            "client_certificate_file",
            "client_private_key_file",
            "client_certificate_subject",
            "ambient_pg_environment"
          ],
          "properties": {
            "uid": {
              "$ref": "#/$defs/UID"
            },
            "source_ip": {
              "$ref": "#/$defs/IP"
            },
            "database_role": {
              "const": "camera_maintenance"
            },
            "control_database": {
              "const": "postgres"
            },
            "control_dsn_file": {
              "$ref": "#/$defs/FileMount"
            },
            "target_dsn_file": {
              "$ref": "#/$defs/FileMount"
            },
            "client_certificate_file": {
              "$ref": "#/$defs/FileMount"
            },
            "client_private_key_file": {
              "$ref": "#/$defs/FileMount"
            },
            "client_certificate_subject": {
              "const": "CN=camera_maintenance"
            },
            "ambient_pg_environment": {
              "const": "reject"
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "uid",
            "gid",
            "source_ip",
            "writer_role",
            "budget_role",
            "writer_dsn_file",
            "budget_dsn_file",
            "rootfs_read_only",
            "linux_capabilities",
            "no_new_privileges",
            "ambient_pg_environment"
          ],
          "properties": {
            "uid": {
              "$ref": "#/$defs/RuntimeID"
            },
            "gid": {
              "$ref": "#/$defs/RuntimeID"
            },
            "source_ip": {
              "$ref": "#/$defs/IP"
            },
            "writer_role": {
              "const": "camera_credential_writer"
            },
            "budget_role": {
              "const": "camera_credential_budget"
            },
            "writer_dsn_file": {
              "$ref": "#/$defs/FileMount"
            },
            "budget_dsn_file": {
              "$ref": "#/$defs/FileMount"
            },
            "rootfs_read_only": {
              "const": true
            },
            "linux_capabilities": {
              "type": "array",
              "maxItems": 0
            },
            "no_new_privileges": {
              "const": true
            },
            "ambient_pg_environment": {
              "const": "reject"
            }
          }
        },
        "key_supply": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_file",
            "source_owner_uid",
            "expected_source_sha256",
            "runtime_directory",
            "runtime_file_name",
            "runtime_directory_mode",
            "runtime_file_mode",
            "copy_policy"
          ],
          "properties": {
            "source_file": {
              "$ref": "#/$defs/Path"
            },
            "source_owner_uid": {
              "$ref": "#/$defs/UID"
            },
            "expected_source_sha256": {
              "$ref": "#/$defs/SHA256"
            },
            "runtime_directory": {
              "$ref": "#/$defs/DirectoryMount"
            },
            "runtime_file_name": {
              "const": "key-bundle.json"
            },
            "runtime_directory_mode": {
              "const": "0500"
            },
            "runtime_file_mode": {
              "const": "0400"
            },
            "copy_policy": {
              "const": "exact-bytes-separate-runtime-owner-v1"
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host_directory",
            "container_directory",
            "owner_uid",
            "runtime_gid",
            "directory_mode",
            "file_mode",
            "runtime_mount_read_only",
            "maintenance_mount_read_only",
            "bootstrap_policy",
            "lock_receipt_host_file",
            "lock_receipt_policy"
          ],
          "properties": {
            "host_directory": {
              "$ref": "#/$defs/Path"
            },
            "container_directory": {
              "$ref": "#/$defs/Path"
            },
            "owner_uid": {
              "$ref": "#/$defs/UID"
            },
            "runtime_gid": {
              "$ref": "#/$defs/RuntimeID"
            },
            "directory_mode": {
              "const": "0750"
            },
            "file_mode": {
              "const": "0640"
            },
            "runtime_mount_read_only": {
              "const": true
            },
            "maintenance_mount_read_only": {
              "const": false
            },
            "bootstrap_policy": {
              "const": "explicit-empty-first-deployment-fenced-v1"
            },
            "lock_receipt_host_file": {
              "$ref": "#/$defs/Path"
            },
            "lock_receipt_policy": {
              "const": "pin-once-outside-snapshots-v1"
            }
          }
        },
        "declared_snapshot_roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Path"
          }
        }
      }
    }
  }
}
