{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vms:camera:planned:credential-admission:v1",
  "title": "Camera credential restore admission v1 (planned, not activated)",
  "$comment": "Static local control-record shape only. Schema does not implement locking, durable IO, monotonic generations, key-ID membership/freshness, trusted runtime/DB binding, restore sequencing, permission checks or anti-rollback. Future parser must reject duplicate/escaped-alias fields and non-integer tokens; bound file to 32768 bytes. Schema 9 marker and runtime gate are not implemented.",
  "x-vms-contract-status": "planned",
  "x-vms-contract-scope": "camera-local-maintenance-record; not HTTP or deployment activation",
  "$ref": "#/$defs/AdmissionRecord",
  "$defs": {
    "UUID4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[^0-9a-f-]"
      }
    },
    "Generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807,
      "description": "Future raw parser requires an int64 integer token, rejecting decimals/exponents/bools."
    },
    "SHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "pattern": "[^0-9a-f]"
      }
    },
    "EncryptionKeyID": {
      "type": "string",
      "pattern": "^enc-[0-9a-f]{16}$",
      "not": {
        "pattern": "[^a-z0-9-]"
      }
    },
    "IdempotencyKeyID": {
      "type": "string",
      "pattern": "^idem-[0-9a-f]{16}$",
      "not": {
        "pattern": "[^a-z0-9-]"
      }
    },
    "UTC": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "not": {
        "pattern": "\\s"
      }
    },
    "DatabaseName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
      "not": {
        "pattern": "[^A-Za-z0-9_]"
      }
    },
    "Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_id",
        "database_name",
        "schema_version",
        "migration_set_sha256",
        "endpoint_profile_sha256",
        "key_bundle_sha256",
        "active_encryption_key_id",
        "active_idempotency_key_id",
        "writer_role",
        "budget_role"
      ],
      "properties": {
        "database_id": {
          "$ref": "#/$defs/UUID4"
        },
        "database_name": {
          "$ref": "#/$defs/DatabaseName"
        },
        "schema_version": {
          "const": 9
        },
        "migration_set_sha256": {
          "$ref": "#/$defs/SHA256"
        },
        "endpoint_profile_sha256": {
          "$ref": "#/$defs/SHA256"
        },
        "key_bundle_sha256": {
          "$ref": "#/$defs/SHA256"
        },
        "active_encryption_key_id": {
          "$ref": "#/$defs/EncryptionKeyID"
        },
        "active_idempotency_key_id": {
          "$ref": "#/$defs/IdempotencyKeyID"
        },
        "writer_role": {
          "const": "camera_credential_writer"
        },
        "budget_role": {
          "const": "camera_credential_budget"
        }
      },
      "description": "Planned schema 9 identity/admission marker, not implemented by this contract. No DSNs, credentials, paths or readiness booleans."
    },
    "AdmissionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "deployment_id",
        "generation",
        "operation_id",
        "state",
        "written_at",
        "counter_policy",
        "seen_encryption_key_ids",
        "binding"
      ],
      "properties": {
        "schema_version": {
          "const": "v1"
        },
        "deployment_id": {
          "$ref": "#/$defs/UUID4"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "operation_id": {
          "$ref": "#/$defs/UUID4"
        },
        "state": {
          "enum": [
            "FENCED",
            "PREPARED",
            "OPEN"
          ]
        },
        "written_at": {
          "$ref": "#/$defs/UTC"
        },
        "counter_policy": {
          "const": "new-key-after-fence-v1"
        },
        "seen_encryption_key_ids": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/EncryptionKeyID"
          }
        },
        "binding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Binding"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "PREPARED",
                  "OPEN"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "binding": {
                "$ref": "#/$defs/Binding"
              },
              "seen_encryption_key_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "binding": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "seen_encryption_key_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
