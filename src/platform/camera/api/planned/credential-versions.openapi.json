{
  "openapi": "3.1.0",
  "info": {
    "title": "Camera credential version metadata and revoke integration API",
    "version": "0.1.0-credential-versions-http",
    "description": "Implemented component for explicit integration; not registered in the current main or active API0.7.0 OpenAPI. Direct TLS1.2+, bearer, trusted principal, transactional MANAGE authorizer, concrete admitted store and a non-nil revoke guard are required. Backup additional work is excluded by user decision."
  },
  "x-runtime-activated": false,
  "x-body-limit-bytes": 65536,
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/credentials/{credential_id}/versions/{credential_version}": {
      "get": {
        "operationId": "getCredentialVersionMetadata",
        "description": "Management inspection of an exact version, including revoked history after parent deletion. No body, query or conditional headers. Uses the actual bound device for MANAGE authorization, a full-operation admission lease and SELECT-only store logic. Does not reserve encryption budget or grant reference, decrypt or dial permission.",
        "parameters": [
          {
            "name": "credential_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          {
            "name": "credential_version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "maxLength": 19,
              "x-maximum-int64": 9223372036854775807,
              "description": "Exact positive signed int64 decimal path token. No leading zero, sign, float, exponent, latest alias, overflow or precision conversion."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Safe exact-version metadata only. Target, secret, ciphertext, key material and readiness are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialVersionReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Query, conditional header, unexpected GET body, idempotency key or strict JSON rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Direct TLS or trusted management permission required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Only GET and DELETE supported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency, usage or resource conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid credential ID, version or revoke semantics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authorization, admission, usage inspection or store unavailable; private errors suppressed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing or unauthorized resource/version; no distinction is disclosed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "revokeCredentialVersion",
        "description": "Logical revocation under the existing transaction, device lock and supplied trusted usage guard. No default unused guard, force override or secret input. Uses exact version, device, trusted identity and a required idempotency key. Successful replay preserves original revocation time and rechecks authorization/admission. In-use returns 409; unknown usage returns 503.",
        "parameters": [
          {
            "name": "credential_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          {
            "name": "credential_version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "maxLength": 19,
              "x-maximum-int64": 9223372036854775807,
              "description": "Exact positive signed int64 decimal path token. No leading zero, sign, float, exponent, latest alias, overflow or precision conversion."
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialRevoke"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Safe exact-version metadata only. Target, secret, ciphertext, key material and readiness are never returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialVersionReceipt"
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Query, conditional header, unexpected GET body, idempotency key or strict JSON rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Direct TLS or trusted management permission required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Only GET and DELETE supported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency, usage or resource conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "DELETE body exceeds 64 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "DELETE Content-Type must be application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid credential ID, version or revoke semantics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authorization, admission, usage inspection or store unavailable; private errors suppressed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CredentialMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_id",
          "device_id",
          "credential_version",
          "created_at"
        ],
        "properties": {
          "credential_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "credential_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "description": "Present after logical revocation; historical metadata remains available to an authorized manager."
          }
        }
      },
      "CredentialVersionReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential",
          "request_id"
        ],
        "properties": {
          "credential": {
            "$ref": "#/components/schemas/CredentialMetadata"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "code",
                    "message"
                  ],
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "CredentialRevoke": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "device_id"
        ],
        "properties": {
          "schema_version": {
            "const": "v1"
          },
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      }
    }
  }
}
